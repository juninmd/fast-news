# Server
PORT=3001
NODE_ENV=development
# Public URL used in Telegram message deep-links (article/story pages)
PUBLIC_URL=https://fast-news.antonio-code.duckdns.org

# PostgreSQL
DATABASE_URL=postgresql://fastnews:fastnews_secret@localhost:5432/fastnews

# Redis
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider — ollama | google | openai | anthropic
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=ollama

# Ollama local (padrão — grátis, roda offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=45000
AI_BACKGROUND_TASK_TIMEOUT_MS=90000

# Google Gemini (alternativa cloud)
# AI_PROVIDER=google
# GEMINI_API_KEY=your_gemini_api_key_here
# ANALYSIS_MODEL=gemini-1.5-pro
# FAST_MODEL=gemini-2.5-flash-lite

# OpenAI (alternativa cloud)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANALYSIS_MODEL=gpt-4o
# FAST_MODEL=gpt-4o-mini

# Anthropic (alternativa cloud)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-3-5-sonnet-20241022
# FAST_MODEL=claude-3-5-haiku-20241022

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Obtenha seu chat ID: abra @userinfobot no Telegram e envie qualquer mensagem
TELEGRAM_CHAT_IDS=123456789
# Modo de execução do bot: polling (padrão), webhook (indicado para clusters) ou none (desativa loop de updates no pod/instância atual)
TELEGRAM_BOT_MODE=polling
# URL pública do webhook (obrigatório apenas se TELEGRAM_BOT_MODE=webhook)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# O Telegram posta todas as notícias novas após análise de integridade no Ollama.
TELEGRAM_QUEUE_NAME=telegram:posts
TELEGRAM_QUEUE_ATTEMPTS=5
TELEGRAM_QUEUE_BACKOFF_MS=15000
TELEGRAM_QUEUE_RATE_LIMIT_MAX=1
TELEGRAM_QUEUE_RATE_LIMIT_DURATION_MS=2500

# ─────────────────────────────────────────────────────────────────────────────
# Cron Schedules
# ─────────────────────────────────────────────────────────────────────────────
CRON_INGESTION=*/30 * * * *
CRON_LEARNING=0 0 * * *
# 8h BRT (UTC-3) = 11h UTC
CRON_DIGEST=0 11 * * *

# ─────────────────────────────────────────────────────────────────────────────
# Ingestion / RAG Config
# ─────────────────────────────────────────────────────────────────────────────
INGESTION_BATCH_SIZE=10
MAX_ARTICLES_PER_FEED=20
INGESTION_FEED_FETCH_TIMEOUT_MS=12000
INGESTION_EMBED_TRUNCATE_CHARS=2000
# Cada chunk vira uma request de embedding; o free tier do Gemini permite 1000/dia.
INGESTION_EMBED_BATCH_SIZE=50
INGESTION_OLLAMA_PROBE_TIMEOUT_MS=5000
INGESTION_JOB_TIMEOUT_MS=1500000
RAG_TOP_K=10

# true = pula ingestion inicial ao subir o servidor (útil em dev)
SKIP_INITIAL_INGESTION=false

# ─────────────────────────────────────────────────────────────────────────────
# Vector Store (postgres | qdrant | sqlite)
# ─────────────────────────────────────────────────────────────────────────────
VECTOR_STORE=postgres
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Recursos inspirados em awesome-ai-news (todos opcionais)
# ─────────────────────────────────────────────────────────────────────────────
# Protege escritas administrativas (importar OPML, editar fontes). Em produção, sem token = fechado.
# ADMIN_TOKEN=
# Canais extras de push (Telegram segue pelo pipeline próprio)
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# NOTIFY_WEBHOOK_URL=
# APPRISE_URL=https://apprise.exemplo/notify/chave
# NTFY_URL=https://ntfy.sh/meu-topico
# Períodos enviados aos canais: 4h,daily,weekly,monthly (vazio = nenhum)
# NOTIFY_DIGEST_PERIODS=daily,weekly
# CRON_DIGEST_4H=0 */4 * * *
# CRON_DIGEST_WEEKLY=0 11 * * 1
# CRON_DIGEST_MONTHLY=0 11 1 * *
# WebSub: avisa o hub quando há artigos novos (ex.: https://pubsubhubbub.appspot.com/)
# WEBSUB_HUB_URL=
# Orçamento de LLM (por processo, por dia). 0 desliga o recurso; RELEVANCE 0 = sem limite.
TRANSLATION_DAILY_LIMIT=300
RELEVANCE_DAILY_LIMIT=0
# TTS do podcast (endpoint compatível com OpenAI /audio/speech). Vazio = desligado.
# TTS_API_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# TTS_DAILY_LIMIT=6
