{
	"name": "fast-news",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"news-agent": "node scripts/news-agent.js",
		"start-agent": "node scripts/news-agent.js --loop",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"test": "vitest",
		"test:e2e": "playwright test",
		"coverage": "vitest run --coverage",
		"dev:api": "pnpm --dir backend dev",
		"dev:mcp": "pnpm --filter @fast-news/mcp dev",
		"docs:dev": "vitepress dev site",
		"docs:build": "vitepress build site",
		"docs:preview": "vitepress preview site",
		"mobile:sync": "vite build && cap sync",
		"mobile:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
		"mobile:android": "vite build && cap sync android && cap open android",
		"mobile:ios": "vite build && cap sync ios && cap open ios"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/browser": "^8.0.5",
		"@capacitor/core": "^8.5.3",
		"@capacitor/share": "^8.0.3",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@vitejs/plugin-react": "^6.0.3",
		"ai": "^7.0.143",
		"autoprefixer": "^10.5.2",
		"dotenv": "^17.4.2",
		"lucide-react": "^1.23.0",
		"postcss": "^8.5.16",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"rss-parser": "^3.13.0",
		"tailwindcss": "^4.3.2",
		"vite": "^8.0.16",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@capacitor/android": "^8.5.3",
		"@capacitor/cli": "^8.5.3",
		"@capacitor/ios": "^8.5.3",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.9",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"msw": "^2.14.6",
		"vitepress": "^1.6.4",
		"vitest": "^4.0.17",
		"vue": "^3.5.43"
	}
}
